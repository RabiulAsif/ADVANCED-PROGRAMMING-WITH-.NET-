@{
    ViewBag.Title = "Edit Product";
}

<h2>Edit Product</h2>

<form method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    <input type="text" name="Name" value="@Model.Name" placeholder="Product Name" class="form-control" />

    <input type="text" name="Price" value="@Model.Price" placeholder="Price" class="form-control" />

    <input type="text" name="Qty" value="@Model.Qty" placeholder="Quantity" class="form-control" />

    Category:
    <select name="CId" class="form-control">
        @foreach (var c in ViewBag.Categories)
        {
            if (c.Id == Model.CId)
            {
                <option value="@c.Id" selected>@c.Name</option>
            }
            else
            {
                <option value="@c.Id">@c.Name</option>
            }
        }
    </select>

    <br />

    <input type="submit" value="Update" class="btn btn-primary" />
</form>
